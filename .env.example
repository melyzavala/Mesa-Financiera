# 1) Copia este archivo y renómbralo como .env   (cp .env.example .env)
# 2) Pega tus llaves después del signo =, sin comillas ni espacios.
# 3) NUNCA subas .env a GitHub (ya está en .gitignore). En GitHub las llaves van en Secrets.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
ALPHAVANTAGE_API_KEY=

# Opcionales
MODELO=gpt-5.5
MODO_CLASE=1
HABILITAR_MODO_REAL=1
MAX_ANALISIS_POR_RUN=3
COOLDOWN_SEGUNDOS=60
# MODO_SIMULACION=1   # quita el # para practicar sin llaves
